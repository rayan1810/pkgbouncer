{
  "name": "pkgbouncer",
  "version": "0.1.0",
  "description": "Install gate for AI coding agents: blocks malicious, hallucinated, typosquatted and risky packages (npm, PyPI, crates.io, Go) before Claude Code or any agent installs them. Hooks + MCP server.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pkgbouncer": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "semver": "^7.6.3",
    "yaml": "^2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/semver": "^7.5.8",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "supply-chain",
    "security",
    "malware",
    "mcp",
    "claude-code",
    "cursor",
    "npm",
    "pypi",
    "cargo",
    "go",
    "osv",
    "typosquat",
    "slopsquatting",
    "hooks",
    "install-gate"
  ],
  "author": "Rohit <rohit@tria.so>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayan1810/pkgbouncer.git"
  },
  "homepage": "https://github.com/rayan1810/pkgbouncer#readme",
  "bugs": {
    "url": "https://github.com/rayan1810/pkgbouncer/issues"
  }
}
